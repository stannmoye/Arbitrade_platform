NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://example.com
DATABASE_URL=mysql://user:password@127.0.0.1:3306/arbitrade
SESSION_SECRET=replace-with-at-least-32-random-characters

# OAuth credentials are server-only. Register the exact callback URLs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/api/oauth/microsoft/callback

# Email delivery: choose SendGrid or SMTP in the installer.
MAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Arbitrade

# 2FA policy/configuration; secrets are generated per customer at runtime.
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER=Arbitrade

# Installer-created admin bootstrap values are consumed once and then removed from this file.
ADMIN_EMAIL=info@wisebond.org
ADMIN_PASSWORD=
