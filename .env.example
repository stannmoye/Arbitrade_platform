NODE_ENV=production
PORT=3000
# Optional shared authentication rate limits for multi-instance production deployments.
# Create a dedicated Redis REST database and keep its token server-side.
# If both values are unset, rate limits remain process-local (not shared across replicas).
# When configured, requests fail closed with HTTP 503 if the shared store is unavailable.
AUTH_RATE_LIMIT_REDIS_REST_URL=
AUTH_RATE_LIMIT_REDIS_REST_TOKEN=
PUBLIC_APP_URL=https://example.com
DATABASE_URL=mysql://arbitrade_user:change-me@127.0.0.1:3306/arbitrade
SESSION_SECRET=generate-a-64-character-random-secret
PASSWORD_PEPPER=generate-a-separate-random-secret
# Stable 32-byte key (64 hex chars or base64) used to encrypt customer TOTP secrets.
# Generate once, keep in a secret manager, and never rotate without a verified migration plan.
# Save the one-time backup codes shown on authenticator enrollment; they are not a substitute for backing up this encryption key.
TOTP_ENCRYPTION_KEY=

# OAuth credentials are server-only. Register the exact callback URLs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/api/oauth/microsoft/callback

# Email transport is configured after installation in the authenticated admin portal.
# No SMTP environment variables are required to start the application.

# Optional daily customer activity digest; set both only after selecting a reporting schedule.
EMAIL_DAILY_DIGEST_TIME=
EMAIL_DAILY_DIGEST_TIMEZONE=

# Private VPS storage. Keep this directory outside the public web root and back it up.
UPLOADS_DIR=./data/uploads

IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Optional direct integrations owned/configured by the operator.
DATA_API_BASE_URL=
DATA_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
OWNER_NOTIFICATION_EMAIL=

# Trading/market data providers are explicitly operator-configured; never use a
# hosted-builder gateway as execution or settlement evidence.
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=
EXECUTION_PROVIDER_URL=
EXECUTION_PROVIDER_API_KEY=
