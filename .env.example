NODE_ENV=production
PORT=3000
# Set to the exact number of trusted reverse-proxy hops; keep 0 for direct access.
# Never set this to "true" or guess the hop count; incorrect values can enable IP spoofing.
TRUST_PROXY_HOPS=0
PUBLIC_APP_URL=https://example.com
DATABASE_URL=mysql://arbitrade_user:change-me@127.0.0.1:3306/arbitrade
SESSION_SECRET=generate-a-64-character-random-secret
PASSWORD_PEPPER=generate-a-separate-random-secret

# OAuth credentials are server-only. Register the exact callback URLs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/api/oauth/microsoft/callback

# Email delivery. This release supports SMTP; keep credentials in server-side secrets, never in app_settings.
MAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Arbitrade
SMTP_REPLY_TO=

# Optional daily customer activity digest; set both only after selecting a reporting schedule.
EMAIL_DAILY_DIGEST_TIME=
EMAIL_DAILY_DIGEST_TIMEZONE=

# Optional provider integrations. Leave unset until configured and approved.
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=
EXECUTION_PROVIDER_URL=
EXECUTION_PROVIDER_API_KEY=
